# ==============================================================================
# Dr. Patt Clinical EMR - Environment Variables Template (.env.example)
# Copy to .env and configure for local or production use
# ==============================================================================

# Application Environment: 'development' or 'production'
DJANGO_ENV=development

# Security Key (Must be at least 50 random characters in production)
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-very-long-secret-key-in-production-min-50-chars

# Debug Mode: True for dev, False for production (MANDATORY FALSE in production)
DEBUG=True

# Allowed Hosts (Comma separated, NO '*' in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=drpatrcl_sys
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# AI Services API Keys (Backend-only, never expose to clients)
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
# Required with OPENAI_API_KEY: an OpenAI model name your account can use
OPENAI_MODEL=
# Which provider drafts SOAP from LINE/web intake: groq | openai
AI_SOAP_PROVIDER=groq
# Let the LINE bot ask AI-generated follow-up questions (max 5 per session, costs budget)
AI_INTAKE_BOT_ENABLED=False
# AI service URL as seen from Django
AI_SERVICE_URL=http://127.0.0.1:8088

# Monthly AI budget per provider (THB). Spending is only computed when both prices are set.
# Fill prices from each provider's current price list (converted to THB per 1M tokens).
AI_BUDGET_THB_GROQ=500
AI_PRICE_THB_PER_1M_INPUT_GROQ=
AI_PRICE_THB_PER_1M_OUTPUT_GROQ=
AI_BUDGET_THB_OPENAI=500
AI_PRICE_THB_PER_1M_INPUT_OPENAI=
AI_PRICE_THB_PER_1M_OUTPUT_OPENAI=
AI_BUDGET_THB_DEEPSEEK=300
AI_PRICE_THB_PER_1M_INPUT_DEEPSEEK=
AI_PRICE_THB_PER_1M_OUTPUT_DEEPSEEK=
AI_BUDGET_THB_GEMINI=300
AI_PRICE_THB_PER_1M_INPUT_GEMINI=
AI_PRICE_THB_PER_1M_OUTPUT_GEMINI=

# LINE OA Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF app id (LINE Developers Console) for the identity/registration form
LINE_LIFF_ID=

# Email (OTP for LINE identity) — Hostinger SMTP. Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@your-clinic-domain
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TSPI Clinic <no-reply@your-clinic-domain>

# Encrypted clinical media (LINE images/audio). Back this folder up together with the DB.
PRIVATE_MEDIA_ROOT=./private_media

# Internal Service-to-Service Secret (>=32 random chars; production refuses to start otherwise)
INTERNAL_API_TOKEN=
