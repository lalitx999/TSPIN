msgid "ความแข็งแรงของอวัยวะ"
msgstr "Organ resilience"

#: apps/core/content.py:57
msgid "แกนที่ 35 - 36"
msgstr "Axes 35 - 36"

#: apps/core/content.py:58
msgid "Organ Resilience & Functional Reserve (ตับ, ไต, หัวใจ)"
msgstr "Organ Resilience & Functional Reserve (liver, kidneys, heart)"

#: apps/core/content.py:59
msgid "Local Organ & Tissue Interface (ตา, ไซนัส, มดลูก)"
msgstr "Local Organ & Tissue Interface (eyes, sinuses, uterus)"

